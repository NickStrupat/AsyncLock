<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>NickStrupat</RootNamespace>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>Nullable</WarningsAsErrors>

        <WeaverConfiguration>
            <Weavers>
                <RuntimeNullables CheckOutputs="true"/>
            </Weavers>
        </WeaverConfiguration>
    </PropertyGroup>

    <PropertyGroup>
        <!-- "AsyncLock" is taken on nuget.org by an unrelated package. -->
        <PackageId>NickStrupat.AsyncLock</PackageId>
        <Version>1.0.0</Version>
        <Authors>Nick Strupat</Authors>
        <Description>A thread-safe, FIFO, allocation-free async lock for .NET, with a Roslyn analyzer that catches lock statements and Monitor calls mistakenly applied to it.</Description>
        <PackageTags>async;lock;mutex;asynclock;synchronization;concurrency;valuetask</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/NickStrupat/AsyncLock</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="RuntimeNullables.Fody" Version="2.1.0" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <!-- IAsyncLock is internal; these implement it, or test and benchmark through it. -->
        <InternalsVisibleTo Include="Candidates"/>
        <InternalsVisibleTo Include="BenchmarkSuite"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Builds the analyzer before this project and applies it to this project's own code. -->
        <ProjectReference Include="..\AsyncLock.Analyzers\AsyncLock.Analyzers.csproj"
                          ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>

        <!-- Ships the analyzer inside this package so consumers get it automatically. -->
        <None Include="..\AsyncLock.Analyzers\bin\$(Configuration)\netstandard2.0\AsyncLock.Analyzers.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>

        <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false"/>
    </ItemGroup>

</Project>
