<Project Sdk="Microsoft.NET.Sdk">

    <!-- Alternative lock implementations, kept for comparison, testing and benchmarking. Not packed: the
         AsyncLock package ships exactly one implementation (AsyncLock). -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>NickStrupat</RootNamespace>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>Nullable</WarningsAsErrors>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\AsyncLock\AsyncLock.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- AsyncLock6 pools its nodes with the same internal pool as AsyncLock. Linking the source gives this
             assembly its own internal copy, so the shipped package needs no InternalsVisibleTo. -->
        <Compile Include="..\AsyncLock\ObjectPool.cs" Link="Shared\ObjectPool.cs" />
        <Compile Include="..\AsyncLock\ConcurrentBoundedQueue.cs" Link="Shared\ConcurrentBoundedQueue.cs" />
    </ItemGroup>

</Project>
