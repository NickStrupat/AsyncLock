<Project Sdk="Microsoft.NET.Sdk">

    <!-- Alternative lock implementations, kept for comparison, testing and benchmarking. Not packed: the
         AsyncLock package ships exactly one implementation (AsyncLock). -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>NickStrupat</RootNamespace>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>Nullable</WarningsAsErrors>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\AsyncLock\AsyncLock.csproj" />
    </ItemGroup>

</Project>
